# Optional AWS region. Model and application defaults live in code.
AWS_REGION=us-east-1

# Financial data
FINANCIAL_DATASETS_API_KEY=

# Alpaca PAPER account only. The backend fixes the host to paper-api.alpaca.markets.
# Standard APCA_API_KEY_ID / APCA_API_SECRET_KEY aliases are also accepted.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Web search (configure whichever providers you use)
EXASEARCH_API_KEY=

# X / Twitter search
X_BEARER_TOKEN=

# Sentiment only: latest TypeSafe Jev through OpenRouter Decisions.
# All agent reasoning and native finance routing stay on Bedrock.
OPENROUTER_API_KEY=

# Optional public-web collection through Apify Actors
APIFY_TOKEN=

# Optional LangSmith tracing credentials (tracing is disabled in code)
LANGSMITH_API_KEY=

